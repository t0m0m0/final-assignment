# ローカル開発用 (cp .env.example .env)。本番では Lambda の環境変数で設定する
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=localpass
DB_NAME=sample_shop
DB_SSL=false

# ローカル実行時 (local/server.mjs) に、API Gateway の JWT オーソライザーの代わりにトークンを検証するための設定。
# Cognito のユーザープール ID とアプリクライアント ID を設定する。Lambda では使わない (API Gateway が検証する)
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
